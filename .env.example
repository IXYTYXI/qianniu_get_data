# 复制为 .env 并填写，勿提交 git

# 飞书自建应用凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Windows 非默认路径时填写（路径含空格请加引号）
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_USER_DATA_DIR=C:\Users\你的用户名\AppData\Local\qianniu-chrome-profile

# 可选：登录页自动填表（仍会自动点击「登录」；验证码/扫码需人工）
# 千牛为「账号登录」时用 QIANNIU_USERNAME（或 QIANNIU_ACCOUNT），不要用手机号变量名误导
# QIANNIU_USERNAME=你的账号
# QIANNIU_PASSWORD=你的密码

# 飞书媒体上传并发（最低 3，可设为 4、5 等）
# FEISHU_UPLOAD_CONCURRENCY=3

# 初高合并开关：1=小学+初高（【初高】【初中】【高中】归入初高）；0=小学+初中+高中
# 也可在 feishu.config.json 设置 "mergeMiddleHigh": true/false
# MERGE_MIDDLE_HIGH=1
